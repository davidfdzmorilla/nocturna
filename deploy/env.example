# Copiar a deploy/.env (ignorado por git) y rellenar.
NOCTURNA_DOMAIN=
NOCTURNA_ACME_EMAIL=
# Para probar sin agotar los limites de emision, usar el entorno de pruebas de la CA:
# NOCTURNA_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Genera con `openssl rand -hex 32`
POSTGRES_PASSWORD=
# Genera con `openssl rand -hex 32`; distinta de POSTGRES_PASSWORD
NOCTURNA_API_DB_PASSWORD=
